---
import { profile } from '../data/profile.js';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <span class="mono footer__name">Omar Samy</span>
      <span class="mono footer__role">{profile.role}</span>
    </div>

    <nav class="footer__links mono" aria-label="Footer">
      <a href={profile.github} target="_blank" rel="noreferrer">github</a>
      <a href={profile.twitter} target="_blank" rel="noreferrer">x</a>
      <a href={profile.linkedin} target="_blank" rel="noreferrer">linkedin</a>
      <a href="/feed.xml">rss</a>
      <a href={`mailto:${profile.email}`}>email</a>
    </nav>

    <span class="mono footer__copy">© {year}</span>
  </div>
</footer>

<style>
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .footer__name {
    font-size: 13px;
    color: var(--text-dim);
  }

  .footer__role {
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12px;
  }

  .footer__links a {
    color: var(--text-faint);
    transition: color 0.2s ease;
  }

  .footer__links a:hover {
    color: var(--accent-pale);
  }

  .footer__copy {
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 720px) {
    .footer :global(.footer__inner) {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
