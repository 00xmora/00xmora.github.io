---
/**
 * 404 — GitHub Pages serves this for any unknown path.
 * It is a real page with real navigation, not a redirect, so a broken inbound
 * link lands somewhere useful instead of a blank error.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/blog.js';

const posts = await getPosts();
const suggestions = posts.slice(0, 4);

const ROUTES = [
  { href: '/', label: '/' },
  { href: '/about/', label: '/about/' },
  { href: '/services/', label: '/services/' },
  { href: '/experience/', label: '/experience/' },
  { href: '/posts/', label: '/posts/' },
  { href: '/tags/', label: '/tags/' },
  { href: '/archives/', label: '/archives/' },
  { href: '/contact/', label: '/contact/' },
];
---

<BaseLayout title="404 — page not found" description="That path does not exist. Here is everything that does.">
  <div class="page">
    <div class="page-head">
      <div class="wrap">
        <p class="page-head__eyebrow">
          <span class="dash" aria-hidden="true"></span>
          error
        </p>

        <h1 id="nf-title">
          <span class="nf__code mono">404</span> — command not found
        </h1>

        <p class="page-head__lede">
          That path isn't part of the site. It may have moved — the blog used to live under
          <code class="mono">/blog/</code> and now lives at <a href="/posts/">/posts/</a>.
        </p>
      </div>
    </div>

    <section class="nf wrap" aria-labelledby="nf-title">
      <div class="nf__block">
        <p class="nf__label mono">available routes</p>
        <ul class="nf__routes">
          {ROUTES.map((r) => (
            <li>
              <a class="mono" href={r.href}>{r.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nf__block">
        <p class="nf__label mono">or try a writeup</p>
        <ul class="nf__routes">
          {suggestions.map((p) => (
            <li>
              <a href={p.url}>{p.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="page-cta__actions nf__actions">
        <a class="btn btn--primary" href="/">Back to the portfolio</a>
        <a class="btn btn--ghost" href="/contact/">Report a broken link</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .nf__code {
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .nf {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 34px;
    padding: 34px 0 100px;
  }

  .nf__label {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border-soft);
  }

  .nf__routes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nf__routes a {
    display: block;
    padding: 8px 10px;
    border-radius: 7px;
    color: var(--text-dim);
    font-size: 14.5px;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s var(--ease);
  }

  .nf__routes a:hover {
    background: rgb(118 146 255 / 8%);
    color: var(--accent-pale);
    transform: translateX(3px);
  }

  .nf__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 10px;
  }

  .page-head__lede code {
    color: var(--accent-pale);
    background: rgb(118 146 255 / 12%);
    padding: 2px 6px;
    border-radius: 5px;
    font-size: 0.9em;
  }
</style>
